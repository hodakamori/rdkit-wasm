{
  "name": "megane-rdkit",
  "version": "0.1.0",
  "description": "RDKit compiled to WebAssembly for megane: ETKDG conformer embedding and MMFF/UFF minimisation today, more RDKit features as megane needs them",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    },
    "./dist/megane-rdkit.mjs": "./dist/megane-rdkit.mjs",
    "./dist/megane-rdkit.wasm": "./dist/megane-rdkit.wasm",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "index.mjs",
    "index.d.ts",
    "dist/megane-rdkit.mjs",
    "dist/megane-rdkit.wasm",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:deps": "bash scripts/build.sh deps",
    "build:rdkit": "bash scripts/build.sh rdkit",
    "build:wrapper": "bash scripts/build.sh wrapper",
    "test": "node test/smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hodakamori/megane-rdkit.git"
  },
  "keywords": [
    "rdkit",
    "wasm",
    "webassembly",
    "chemistry",
    "conformer",
    "etkdg",
    "mmff",
    "uff",
    "megane"
  ],
  "homepage": "https://github.com/hodakamori/megane-rdkit#readme",
  "bugs": "https://github.com/hodakamori/megane-rdkit/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
